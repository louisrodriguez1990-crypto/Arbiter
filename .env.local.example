# Next.js loads both `.env` and `.env.local` from the project root (same folder as package.json).
# Use `.env.local` for local secrets and Phase 1 configuration.
#
# Copy to `.env.local`:
#   copy .env.local.example .env.local

# Phase 2 reasoning
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Arbiter

# Phase 1 detection
EBAY_APP_ID=
ARBITER_DB_PATH=data/arbiter.sqlite

# Optional public evidence sources still used by the older research route
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
